# --- SkyCast Pro AI proxy — environment variables -------------------------
# Copy this file to `.env` for local `vercel dev` / `netlify dev`.
# NEVER commit your real .env or expose these values to the browser.

# Your AI provider secret key (required). Keep it server-side only.
AI_API_KEY=sk-your-key-here

# Any OpenAI-compatible chat model (optional).
AI_MODEL=gpt-4o-mini

# OpenAI-compatible base URL (optional). Examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Comma-separated list of browser origins allowed to call the function (optional).
ALLOWED_ORIGINS=https://rohitkuma07.github.io
